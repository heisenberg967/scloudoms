{
  "name": "screencloud-oms",
  "version": "1.0.0",
  "description": "Order quotes and transactional fulfillment for SCOS devices",
  "main": "dist/presentation/main.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/presentation/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/presentation/main.js",
    "lint": "tsc --noEmit && tsc --project tsconfig.tests.json",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:unit": "npm test -- tests/unit",
    "test:integration": "npm test -- tests/integration",
    "test:pg": "npm run test:integration",
    "test:watch": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\""
  },
  "keywords": [
    "order-management",
    "fulfillment-optimization",
    "hexagonal-architecture",
    "screencloud"
  ],
  "license": "ISC",
  "dependencies": {
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.2.1",
    "postgres": "^3.4.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "~4.1.11"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
