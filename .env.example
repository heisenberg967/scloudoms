# Copy to .env for local development. Never use this token or password on a public deployment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/screencloud_oms
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/screencloud_oms
API_TOKEN=local-development-token-change-before-deployment
PORT=3000
# Development only: consume pending outbox events by writing full payloads to stdout.
OUTBOX_LOG_EVENTS=false
